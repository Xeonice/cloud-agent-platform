{
  "name": "cloud-agent-platform",
  "version": "0.0.0",
  "private": true,
  "description": "Single-user, self-hostable control plane that drives the real interactive Codex CLI and streams its byte-identical terminal to a browser.",
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:discovery": "node scripts/test-discovery-check.mjs && node --test --test-force-exit scripts/test-discovery-check.test.mjs",
    "test:agent-identity": "node scripts/agent-identity-branch-check.mjs && node --test --test-force-exit scripts/agent-identity-branch-check.test.mjs",
    "test:provider-parity": "node scripts/provider-contract-parity-check.mjs && node --test --test-force-exit scripts/provider-contract-parity-check.test.mjs",
    "test:vocabulary-parity": "node scripts/sandbox-core-vocabulary-parity.mjs && node --test --test-force-exit scripts/sandbox-core-vocabulary-parity.test.mjs",
    "test:contracts-shared": "node scripts/contracts-shared-export-check.mjs && node --test --test-force-exit scripts/contracts-shared-export-check.test.mjs",
    "test:contracts-executed": "node scripts/contracts-executed-schema-check.mjs && node --test --test-force-exit scripts/contracts-executed-schema-check.test.mjs",
    "test:module-layout": "node scripts/api-module-layout-check.mjs && node --test --test-force-exit scripts/api-module-layout-check.test.mjs",
    "test:cors-headers": "node scripts/console-request-header-cors-check.mjs && node --test --test-force-exit scripts/console-request-header-cors-check.test.mjs",
    "test:boundaries": "node scripts/boundaries-manifest-check.mjs && node --test --test-force-exit scripts/boundaries-manifest-check.test.mjs",
    "test:context-layout-v2": "node scripts/context-layout-check-v2.mjs && node --test --test-force-exit scripts/context-layout-check-v2.test.mjs",
    "test:security-seams": "node scripts/security-seam-check.mjs && node --test --test-force-exit scripts/security-seam-check.test.mjs",
    "test:agent-docs": "node scripts/claude-md-dependency-reconcile.mjs && node --test --test-force-exit scripts/claude-md-dependency-reconcile.test.mjs",
    "test:scripts": "node scripts/run-suite.mjs \"scripts/*.test.mjs\" \"scripts/ratchets/*.test.mjs\"",
    "verify": "turbo typecheck lint build && pnpm verify:terminal-response-profile",
    "verify:terminal-response-profile": "node scripts/terminal-response-profile-source-conformance.mjs && node --test scripts/terminal-response-profile-source-conformance.test.mjs",
    "test:terminal-coordinated-rollback": "pnpm -w exec turbo run build --filter=@cap-console/api && CAP_TERMINAL_ROLLBACK_CANARY=1 node --test scripts/terminal-coordinated-rollback-canary.test.mjs",
    "test:public-surface": "node scripts/public-surface-tests.mjs fast",
    "test:public-surface:watch": "node scripts/public-surface-tests.mjs watch",
    "verify:public-surface": "node scripts/public-surface-tests.mjs full",
    "test:sandbox": "pnpm --filter @cap-console/sandbox-core test && pnpm --filter @cap-console/sandbox-conformance test && pnpm --filter @cap-console/sandbox-cloud-http test && pnpm --filter @cap-console/sandbox-provider-aio test && pnpm --filter @cap-console/sandbox-provider-boxlite test && pnpm --filter @cap-console/sandbox test",
    "test:sandbox:e2e": "pnpm --filter @cap-console/sandbox-provider-aio test:e2e && pnpm --filter @cap-console/sandbox-provider-boxlite test:e2e",
    "test:integration:schedules": "pnpm --filter @cap-console/api test:integration:schedules",
    "test:integration:task-model-surfaces": "pnpm --filter @cap-console/api test:integration:task-model-surfaces",
    "test:e2e:claude-model-artifact-evidence": "pnpm --filter @cap-console/api test:e2e:claude-model-artifact-evidence",
    "test:e2e:task-model-real-credential": "pnpm --filter @cap-console/api test:e2e:task-model-real-credential",
    "test:e2e:schedules:local": "bash scripts/scheduled-tasks-live-e2e.sh",
    "test:web:provider-terminal-story": "pnpm --filter @cap-console/web test:provider-terminal-story",
    "prepare": "husky",
    "test:quarantined": "node scripts/run-suite.mjs --only-quarantined \"scripts/*.test.mjs\" && pnpm --filter @cap-console/api test:quarantined"
  },
  "devDependencies": {
    "c8": "^11.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "//": "pnpm 10 blocks dependency build scripts by default; node-pty needs its node-gyp native build to run, otherwise pty.node is missing at runtime (esp. in the runner Docker image).",
    "onlyBuiltDependencies": [
      "node-pty"
    ]
  }
}
