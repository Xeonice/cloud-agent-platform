      ],
      "describe": "迁移是 DELETE 不是 UPDATE——改写会把 legacy 任务谎称成 durable",
      "run": [
        "bash",
        "-c",
        "if grep -rqiE \"set[^;]*admission_mode[[:space:]]*=|update[[:space:]]+\\\"?task_provisioning_diagnostic_(attempts|events)\\\"?\" apps/api/prisma/migrations 2>/dev/null; then echo REWRITES; else echo DELETES_ONLY; fi"
