      ],
      "describe": "已发布枚举只剩 durable 成员（源码口径，不依赖构建产物）",
      "run": [
        "bash",
        "-c",
        "sed -n '/TaskProvisioningDiagnosticAdmissionModeSchema = z.enum/,/\\]/p' packages/contracts/src/task-provisioning-diagnostics.ts | grep -c \"'legacy'\""
      ],
      "expect": {
        "stdoutEquals": "0"
      }
    },
