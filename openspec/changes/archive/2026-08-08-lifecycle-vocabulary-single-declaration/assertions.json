      "expect": {
        "stdoutAbsent": "Extract<"
      }
    },
    {
      "id": "admission-target-vocabulary-derived",
      "requirements": [
        "task-lifecycle-vocabulary/the-admission-transition-subset-is-declared-once-and-consumed-not-restated"
      ],
      "describe": "admission 目标态词表不再被内联复述；唯一豁免是 guardrails.service.spec.ts——活 spec 按行号钉住它六处反射断言标识符（openspec/specs/guardrails/spec.md:1112-1114），加一行 import 会让那条场景变假",
      "run": [
        "bash",
        "-c",
        "grep -rln \"Extract<TaskStatus, 'queued' | 'running'>\" apps/api/src --include='*.ts' | grep -v 'guardrails.service.spec.ts' || true"
