        "-c",
        "grep -cE \"(^import .*task-lifecycle|require\\(.*task-lifecycle)\" apps/api/src/tasks/task-lifecycle.test.mjs"
      ],
      "expect": {
        "stdoutMatches": "^[1-9]"
      }
    },
