{
  "name": "@cap/sandbox",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "CAP sandbox provider center, provider-neutral lifecycle/workspace helpers, and adapter facade.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "testing": [
        "dist/testing.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.js",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "src",
    "docs"
  ],
  "scripts": {
    "build": "pnpm --filter @cap/contracts build && pnpm --filter @cap/sandbox-core build && pnpm --filter @cap/sandbox-environment build && pnpm --filter @cap/sandbox-cloud-http build && pnpm --filter @cap/sandbox-provider-aio build && pnpm --filter @cap/sandbox-provider-boxlite build && pnpm --filter @cap/sandbox-conformance build && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm -w exec turbo run build --filter=@cap/sandbox",
    "test": "node --test --test-force-exit \"test/**/*.test.mjs\"",
    "coverage": "c8 --100 --include=dist/**/*.js --reporter=text node --test --test-force-exit \"test/**/*.test.mjs\"",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@cap/contracts": "workspace:*",
    "@cap/sandbox-cloud-http": "workspace:*",
    "@cap/sandbox-core": "workspace:*",
    "@cap/sandbox-environment": "workspace:*",
    "@cap/sandbox-provider-aio": "workspace:*",
    "@cap/sandbox-provider-boxlite": "workspace:*"
  },
  "devDependencies": {
    "@cap/eslint-config": "workspace:*",
    "@cap/sandbox-conformance": "workspace:*",
    "@cap/tsconfig": "workspace:*",
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.12",
    "eslint": "^9.27.0",
    "typescript": "^5.5.4",
    "ws": "^8.18.0"
  }
}
