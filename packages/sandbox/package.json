{
  "name": "@cap-console/sandbox",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "CAP sandbox provider center, provider-neutral lifecycle/workspace helpers, and adapter facade.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "docs"
  ],
  "scripts": {
    "build": "pnpm --filter @cap-console/contracts build && pnpm --filter @cap-console/sandbox-core build && pnpm --filter @cap-console/sandbox-environment build && pnpm --filter @cap-console/sandbox-cloud-http build && pnpm --filter @cap-console/sandbox-provider-aio build && pnpm --filter @cap-console/sandbox-provider-boxlite build && pnpm --filter @cap-console/sandbox-conformance build && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm -w exec turbo run build --filter=@cap-console/sandbox",
    "test": "node test/facade-surface.gate.mjs && node --test --test-force-exit \"test/**/*.test.mjs\"",
    "coverage": "c8 --100 --include=dist/**/*.js --reporter=text node --test --test-force-exit \"test/**/*.test.mjs\"",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@cap-console/contracts": "workspace:*",
    "@cap-console/sandbox-cloud-http": "workspace:*",
    "@cap-console/sandbox-core": "workspace:*",
    "@cap-console/sandbox-environment": "workspace:*",
    "@cap-console/sandbox-provider-aio": "workspace:*",
    "@cap-console/sandbox-provider-boxlite": "workspace:*"
  },
  "devDependencies": {
    "@cap-console/eslint-config": "workspace:*",
    "@cap-console/sandbox-conformance": "workspace:*",
    "@cap-console/tsconfig": "workspace:*",
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.12",
    "eslint": "^9.27.0",
    "typescript": "^5.5.4",
    "ws": "^8.18.0"
  }
}
