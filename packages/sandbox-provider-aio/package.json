{
  "name": "@cap/sandbox-provider-aio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AIO/Docker sandbox provider lifecycle controller for CAP.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "pnpm --filter @cap/sandbox-core build && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm -w exec turbo run build --filter=@cap/sandbox-provider-aio --filter=@cap/sandbox-conformance",
    "test": "node --test --test-force-exit \"test/**/*.test.mjs\"",
    "test:e2e": "pnpm build && node --test --test-force-exit e2e/*.e2e.mjs",
    "coverage": "c8 --100 --include=dist/**/*.js --reporter=text node --test --test-force-exit \"test/**/*.test.mjs\"",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@cap/sandbox-core": "workspace:*",
    "dockerode": "^5.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@cap/eslint-config": "workspace:*",
    "@cap/sandbox-conformance": "workspace:*",
    "@cap/tsconfig": "workspace:*",
    "@types/dockerode": "^4.0.1",
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.12",
    "eslint": "^9.27.0",
    "typescript": "^5.5.4"
  }
}
