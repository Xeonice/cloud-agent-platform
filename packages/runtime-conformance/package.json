{
  "name": "@cap-console/runtime-conformance",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Agent-runtime conformance suite for CAP: harness-maker seam, compile-time participation ledger, five ported scenario families, per-runtime report artifact.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "pnpm --filter @cap-console/contracts build && pnpm --filter @cap-console/sandbox build && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm -w exec turbo run build --filter=@cap-console/runtime-conformance",
    "test": "node --test --test-force-exit \"test/**/*.test.mjs\"",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@cap-console/contracts": "workspace:*",
    "@cap-console/sandbox": "workspace:*"
  },
  "devDependencies": {
    "@cap-console/eslint-config": "workspace:*",
    "@cap-console/tsconfig": "workspace:*",
    "@types/node": "^20.14.0",
    "eslint": "^9.27.0",
    "typescript": "^5.5.4"
  }
}
